HF_TOKEN=
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=gazprom_dataset_e5
MODEL_NAME=d0rj/e5-base-en-ru
TOP_K_DEFAULT=5
TOP_K_MAX=50
RERANK_TOP_N=8
RERANK_SEMANTIC_WEIGHT=0.7
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_STORE_BACKEND=postgres
JOB_STORE_BACKEND=postgres

STORAGE_BACKEND=local
